# ===== Sakhi Khata settings =====
# Copy this file to .env and fill it in.
ENV=prod
# REQUIRED: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
DATABASE_URL=
# Local: your ngrok https URL, no trailing slash. On Render leave blank (RENDER_EXTERNAL_URL is used automatically); set only for a custom domain.
PUBLIC_URL=

# --- same values as MaaSakhi ---
# gsk_...   (order understanding + voice notes)
GROQ_API_KEY=
# AC...
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# optional, e.g. join silver-tiger  (shown on the landing page)
SANDBOX_JOIN_PHRASE=

GROQ_MODEL=llama-3.3-70b-versatile
GROQ_STT_MODEL=whisper-large-v3
# vision model: reads handwritten orders and pre-screens sample photos against the buyer's checklist
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# kn / hi / en, empty = auto-detect
STT_LANGUAGE=

# --- you (the real user, not a fictional one) ---
OWNER_PHONE=9315168344
OWNER_NAME=Owner
# leader | buyer | seller | officer. On WhatsApp send "ROLE buyer" / "ROLE leader" / "ROLE member" to act as each in turn.
OWNER_ROLE=leader
GROUP_NAME=My SHG
# 1 = any number that messages the bot can register as buyer/member. Set 0 once real members are added.
OPEN_REGISTRATION=1

# members who must approve a payout besides the leader (set 1 if you test with few numbers)
PAYOUT_MEMBER_QUORUM=2
ESCALATION_MINUTES=120
CRON_SECRET=
# Reminder engine (POST /api/cron/reminders with header X-Cron-Secret, every 15-30 min). Defaults shown.
# TASK_REMIND_DAYS=1
# SAMPLE_NUDGE_MINUTES=60
# PAYOUT_NUDGE_HOURS=24
# REMINDER_COOLDOWN_HOURS=24

# --- hosting ---
# In-process reminder/escalation loop (on by default in prod). Set 0 if you call /api/cron/reminders from an external cron.
# ENABLE_SCHEDULER=1
# SCHEDULER_MINUTES=15
